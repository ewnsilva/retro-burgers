{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "modules/*": ["src/app/Modules/*"],
      "shared/*": ["src/app/Shared/*"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
